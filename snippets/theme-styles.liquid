{% doc %}
  Writes the colour tokens and the system font stack used on the storefront.
  The stack matches the approved preview. It does not load a hosted font.
  @example
  {% render 'theme-styles' %}
{% enddoc %}

{% style %}
  :root {
    --stone: {{ settings.color_stone }};
    --earth: {{ settings.color_earth }};
    --sky: {{ settings.color_sky }};
    --warm: {{ settings.color_warm }};
    --cream: {{ settings.color_cream }};
    --white: {{ settings.color_white }};
    --dark: {{ settings.color_dark }};
    --font-heading: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-heading-weight: 600;
  }
{% endstyle %}
