<section class="hero" id="{{ section.settings.anchor | handleize }}">
  <div class="hero-copy">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero-actions">
      <a class="hero-cta" href="{% if section.settings.primary_link != blank %}{{ section.settings.primary_link }}{% else %}#visualizer{% endif %}">{{ section.settings.primary_label }}</a>
      <a class="hero-cta secondary" href="{% if section.settings.secondary_link != blank %}{{ section.settings.secondary_link }}{% else %}#contact{% endif %}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
  <figure class="hero-stage">
    {% if section.settings.image != blank %}
      {% if section.index == 1 %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-media', alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high', widths: '600, 1000, 1400, 1800, 2400', sizes: '100vw' }}
      {% else %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-media', alt: section.settings.image_alt, loading: 'lazy', widths: '600, 1000, 1400, 1800, 2400', sizes: '100vw' }}
      {% endif %}
    {% else %}
      <picture>
        <img
          class="hero-media"
          src="{{ 'landmark-wide.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="2000"
          height="1125"
          {% if section.index == 1 %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
        >
      </picture>
    {% endif %}
    <figcaption class="hero-caption">{{ section.settings.caption }}</figcaption>
  </figure>
</section>

{% if template.name == 'index' and section.index == 1 %}
  {% liquid
    if section.settings.image != blank
      assign hero_image = section.settings.image | image_url: width: 1600
    else
      assign hero_image = 'landmark-wide.jpg' | asset_url
    endif
    unless hero_image contains 'https:'
      assign hero_image = hero_image | prepend: 'https:'
    endunless
  %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "image": {{ hero_image | json }},
      "description": {{ section.settings.text | json }},
      "areaServed": { "@type": "Country", "name": "United Kingdom" },
      "serviceType": ["Bespoke stone sculpture", "Site assessment", "Stone sourcing", "Community build experience"]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.hero.settings.anchor.label",
      "default": "top"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "Raised on open ground"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "See it where it will stand."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.hero.settings.primary_label.label",
      "default": "See It on Your Land"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.hero.settings.primary_link.label"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.hero.settings.secondary_label.label",
      "default": "Begin Your Build"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.hero.settings.secondary_link.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "default": "Handbuilt stone landmark on open grassland, with hills and sky behind it"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption",
      "default": "Every stone chosen for its place. Stacked by hand, balanced without mortar. Made with you, for the land that will hold it."
    }
  ],
  "presets": [
    { "name": "t:sections.hero.presets.name" }
  ]
}
{% endschema %}
