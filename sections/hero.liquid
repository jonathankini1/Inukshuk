<section class="hero" id="{{ section.settings.anchor | handleize }}">
  <figure class="hero-plate">
    {% if section.settings.image != blank %}
      {% if section.index == 1 %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hero-media', alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high', widths: '400, 700, 1000, 1400, 1600', sizes: '(min-width: 860px) 46vw, 78vw' }}
      {% else %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hero-media', alt: section.settings.image_alt, loading: 'lazy', widths: '400, 700, 1000, 1400, 1600', sizes: '(min-width: 860px) 46vw, 78vw' }}
      {% endif %}
    {% else %}
      <img
        class="hero-media"
        src="{{ 'landmark-front.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1200"
        height="1600"
        {% if section.index == 1 %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
      >
    {% endif %}
    {% if section.settings.caption != blank %}
      <figcaption>{{ section.settings.caption }}</figcaption>
    {% endif %}
  </figure>
  <div class="hero-copy">
    <figure class="hero-study">
      <img
        src="{{ 'inukshuk-study.webp' | asset_url }}"
        alt="{{ section.settings.study_alt | escape }}"
        width="854"
        height="1117"
        loading="eager"
        decoding="async"
      >
      {% if section.settings.study_caption != blank %}
        <figcaption>{{ section.settings.study_caption }}</figcaption>
      {% endif %}
    </figure>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero-actions">
      <a class="hero-cta" href="{% if section.settings.primary_link != blank %}{{ section.settings.primary_link }}{% else %}#visualizer{% endif %}">{{ section.settings.primary_label }}</a>
      <a class="hero-cta secondary" href="{% if section.settings.secondary_link != blank %}{{ section.settings.secondary_link }}{% else %}#contact{% endif %}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
</section>

{% if template.name == 'index' and section.index == 1 %}
  {% liquid
    if section.settings.image != blank
      assign hero_image = section.settings.image | image_url: width: 1600
    else
      assign hero_image = 'landmark-front.jpg' | asset_url
    endif
    unless hero_image contains 'https:'
      assign hero_image = hero_image | prepend: 'https:'
    endunless
  %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "image": {{ hero_image | json }},
      "description": {{ section.settings.text | json }},
      "areaServed": { "@type": "Country", "name": "United Kingdom" },
      "serviceType": ["Bespoke stone sculpture", "Site assessment", "Stone sourcing", "Community build experience"]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.hero.settings.anchor.label",
      "default": "top"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "A Monument Built By Your Own Hands"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "Commission a bespoke Inukshuk stone sculpture for your estate, garden, or land. An ancient art form, reimagined as a gathering of people, stone, and story."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.hero.settings.primary_label.label",
      "default": "See It on Your Land"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.hero.settings.primary_link.label"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.hero.settings.secondary_label.label",
      "default": "Begin Your Build"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.hero.settings.secondary_link.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "default": "Front view of a handbuilt stone Inukshuk"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption",
      "default": "Built stone by stone"
    },
    {
      "type": "text",
      "id": "study_alt",
      "label": "t:sections.hero.settings.study_alt.label",
      "default": "The same stone Inukshuk, lifted from a photograph and set on the page. Not a site view and not to scale."
    },
    {
      "type": "text",
      "id": "study_caption",
      "label": "t:sections.hero.settings.study_caption.label",
      "default": "Not to scale"
    }
  ],
  "presets": [
    { "name": "t:sections.hero.presets.name" }
  ]
}
{% endschema %}
