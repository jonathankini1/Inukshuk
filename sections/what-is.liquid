<section class="what-is" id="{{ section.settings.anchor | default: 'what' | handleize }}">
  <div class="container">
    <div class="what-is-grid">
      <div class="what-is-text">
        <h2>{{ section.settings.heading }}</h2>
        {{ section.settings.body }}
        {% if section.settings.badge != blank %}
          <div class="origin-badge">{{ section.settings.badge }}</div>
        {% endif %}
      </div>
      <div class="stone-visual">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 768px) 50vw, 100vw' }}
        {% else %}
          <img
            src="{{ 'stone-detail.jpg' | asset_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="1500"
            height="2000"
            loading="lazy"
            decoding="async"
          >
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.what_is.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "t:labels.anchor",
      "default": "what"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What Is an Inukshuk?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.text",
      "default": "<p>An Inukshuk is a stone landmark built by the Inuit peoples of the Canadian Arctic. Traditionally used as navigation markers across vast, featureless landscapes, they are human-shaped figures assembled from carefully balanced stones. Each one is unique, and none is held together by mortar.</p><p>Today, they stand as symbols of guidance, hope, friendship, and the power of working together. Each Inukshuk is a communal act because the stones are too heavy for one person alone. It takes a gathering to raise one.</p><p>We bring this tradition to private estates across the UK and beyond. Your Inukshuk becomes a permanent landmark on your land, built with your people and your stone.</p>"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:sections.what_is.settings.badge.label",
      "default": "From the Inuktitut: \"in the likeness of a human\""
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "default": "Finished stone Inukshuk standing in a Pennine landscape"
    }
  ],
  "presets": [
    { "name": "t:sections.what_is.presets.name" }
  ]
}
{% endschema %}
