<section class="what-is" id="{{ section.settings.anchor | default: 'what' | handleize }}">
  <div class="container">
    <div class="what-is-grid">
      <div class="what-is-text">
        <h2>{{ section.settings.heading }}</h2>
        {{ section.settings.body }}
        <p class="origin-badge"><em class="inuktitut">inuksuk</em>. {{ section.settings.badge }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.what_is.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "t:labels.anchor",
      "default": "what"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What is an inuksuk?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.text",
      "default": "<p>An <em>inuksuk</em> is a stone figure built without mortar by Inuit in the Arctic. It marks a route or a place. The stones are lifted by a group, not by one person.</p><p>We commission the same kind of landmark for private land in the UK. Local stone where the ground allows it. A site visit before any build.</p>"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:sections.what_is.settings.badge.label",
      "default": "Inuktitut for a figure in the likeness of a person."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.image_alt",
      "default": "Finished stone Inukshuk standing in a Pennine landscape"
    }
  ],
  "presets": [
    { "name": "t:sections.what_is.presets.name" }
  ]
}
{% endschema %}
