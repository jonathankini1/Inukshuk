<section
  class="contact"
  id="{{ section.settings.anchor | default: 'contact' | handleize }}"
  data-enquiry
  data-msg-required="{{ 'sections.enquiry.field_required' | t | escape }}"
  data-msg-email="{{ 'sections.enquiry.email_invalid' | t | escape }}"
  data-msg-short="{{ 'sections.enquiry.too_short' | t: count: '__COUNT__' | escape }}"
  data-msg-summary="{{ 'sections.enquiry.check_fields' | t | escape }}"
>
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="contact-layout">
      <aside class="contact-panel">
        <h3>{{ section.settings.panel_heading }}</h3>
        <p>{{ section.settings.panel_text }}</p>
        <ul class="contact-promises">
          {% assign promises = section.settings.promises | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | split: '|' %}
          {% for promise in promises %}
            {% assign promise_text = promise | strip %}
            {% if promise_text != blank %}
              <li>{{ promise_text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </aside>
      {% form 'contact', id: 'enquiry-form', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <div class="form-banner form-banner--success" role="status" tabindex="-1" data-form-banner>
            <p>{{ section.settings.success_message }}</p>
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="form-banner form-banner--error" role="alert" tabindex="-1" data-form-banner>
            <p>{{ 'sections.enquiry.error_heading' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div class="form-grid">
          <div class="form-group">
            <label for="enquiry-name">{{ 'sections.enquiry.name' | t }}</label>
            <input id="enquiry-name" name="contact[name]" type="text" autocomplete="name" placeholder="{{ section.settings.name_placeholder }}" value="{{ form.name }}" required data-enquiry-name aria-describedby="name-error">
            <span class="field-error" id="name-error"></span>
          </div>
          <div class="form-group">
            <label for="enquiry-email">{{ 'sections.enquiry.email' | t }}</label>
            <input id="enquiry-email" name="contact[email]" type="email" autocomplete="email" inputmode="email" placeholder="{{ section.settings.email_placeholder }}" value="{{ form.email }}" required aria-describedby="email-error">
            <span class="field-error" id="email-error"></span>
          </div>
          <div class="form-group">
            <label for="enquiry-location">{{ 'sections.enquiry.location' | t }}</label>
            <input id="enquiry-location" name="contact[property_location]" type="text" autocomplete="address-level2" placeholder="{{ section.settings.location_placeholder }}" required aria-describedby="location-error">
            <span class="field-error" id="location-error"></span>
          </div>
          <div class="form-group">
            <label for="enquiry-land-size">{{ 'sections.enquiry.land' | t }}</label>
            <select id="enquiry-land-size" name="contact[land_size]" required aria-describedby="land-size-error">
              <option value="">{{ 'sections.enquiry.land_placeholder' | t }}</option>
              <option>{{ 'sections.enquiry.land_under_1' | t }}</option>
              <option>{{ 'sections.enquiry.land_1_5' | t }}</option>
              <option>{{ 'sections.enquiry.land_5_20' | t }}</option>
              <option>{{ 'sections.enquiry.land_over_20' | t }}</option>
              <option>{{ 'sections.enquiry.land_unsure' | t }}</option>
            </select>
            <span class="field-error" id="land-size-error"></span>
          </div>
          <div class="form-group">
            <label for="enquiry-package">{{ 'sections.enquiry.scale' | t }}</label>
            <select id="enquiry-package" name="contact[project_scale]" data-project-scale>
              <option value="">{{ 'sections.enquiry.scale_unsure' | t }}</option>
              <option value="Garden">{{ section.settings.garden_option }}</option>
              <option value="Estate">{{ section.settings.estate_option }}</option>
              <option value="Landmark">{{ section.settings.landmark_option }}</option>
            </select>
            <span class="field-error" aria-hidden="true"></span>
          </div>
          <div class="form-group">
            <label for="enquiry-timeline">{{ 'sections.enquiry.timing' | t }}</label>
            <select id="enquiry-timeline" name="contact[ideal_timing]">
              <option value="">{{ 'sections.enquiry.timing_exploring' | t }}</option>
              <option>{{ 'sections.enquiry.timing_3' | t }}</option>
              <option>{{ 'sections.enquiry.timing_6' | t }}</option>
              <option>{{ 'sections.enquiry.timing_12' | t }}</option>
              <option>{{ 'sections.enquiry.timing_year' | t }}</option>
            </select>
            <span class="field-error" aria-hidden="true"></span>
          </div>
          <div class="form-group full">
            <label for="enquiry-vision">{{ 'sections.enquiry.vision' | t }}</label>
            <textarea id="enquiry-vision" name="contact[body]" placeholder="{{ section.settings.vision_placeholder }}" required minlength="20" aria-describedby="vision-error">{{ form.body }}</textarea>
            <span class="field-error" id="vision-error"></span>
          </div>
        </div>
        <label class="consent-row" for="enquiry-consent">
          <input id="enquiry-consent" name="contact[consent]" type="checkbox" value="Agreed" required aria-describedby="consent-error">
          <span>
            {{ 'sections.enquiry.consent' | t }}
            {% if pages.privacy.url != blank %}
              <a href="{{ pages.privacy.url }}">{{ 'sections.enquiry.privacy' | t }}</a>.
            {% else %}
              {{ 'sections.enquiry.privacy' | t }}.
            {% endif %}
            <span class="field-error" id="consent-error"></span>
          </span>
        </label>
        <button class="submit-btn" type="submit">{{ section.settings.button_label }}</button>
        <p class="form-status" data-enquiry-status role="status" aria-live="polite"></p>
      {% endform %}
    </div>
  </div>
</section>

{% javascript %}
(() => {
  const boot = (root) => {
    const scope = root && root.querySelectorAll ? root : document;
    scope.querySelectorAll('[data-enquiry]').forEach((section) => {
      const banner = section.querySelector('[data-form-banner]');
      if (banner) banner.focus();
      const form = section.querySelector('form');
      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';
      form.setAttribute('novalidate', 'novalidate');
      const status = section.querySelector('[data-enquiry-status]');
      const requiredMessage = section.getAttribute('data-msg-required');
      const emailMessage = section.getAttribute('data-msg-email');
      const shortTemplate = section.getAttribute('data-msg-short');
      const summaryMessage = section.getAttribute('data-msg-summary');
      const fieldError = (field, message) => {
        field.setAttribute('aria-invalid', message ? 'true' : 'false');
        const errorId = field.getAttribute('aria-describedby');
        const error = errorId ? document.getElementById(errorId) : null;
        if (error) error.textContent = message;
      };
      const validateField = (field) => {
        let message = '';
        if (field.validity.valueMissing) message = requiredMessage;
        else if (field.validity.typeMismatch) message = emailMessage;
        else if (field.validity.tooShort) message = (shortTemplate || '').replace('__COUNT__', String(field.minLength));
        fieldError(field, message);
        return !message;
      };
      [...form.elements].forEach((field) => {
        if (!field.matches || !field.matches('input, select, textarea')) return;
        field.addEventListener(field.type === 'checkbox' ? 'change' : 'input', () => {
          if (field.getAttribute('aria-invalid') === 'true') validateField(field);
        });
      });
      form.addEventListener('submit', (event) => {
        const requiredFields = [...form.querySelectorAll('[required]')];
        const valid = requiredFields.map(validateField).every(Boolean);
        if (!valid) {
          event.preventDefault();
          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid) firstInvalid.focus();
          if (status) status.textContent = summaryMessage;
        }
      });
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => boot(document));
  else boot(document);
  document.addEventListener('shopify:section:load', (event) => boot(event.target));
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.enquiry.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "t:labels.anchor", "default": "contact" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Start the Conversation" },
    { "type": "textarea", "id": "subheading", "label": "t:labels.subheading", "default": "Tell us about your land, your vision, and the people you want to build with." },
    { "type": "text", "id": "panel_heading", "label": "t:sections.enquiry.settings.panel_heading.label", "default": "A useful first conversation" },
    { "type": "textarea", "id": "panel_text", "label": "t:sections.enquiry.settings.panel_text.label", "default": "You do not need drawings or a finished brief. A location, a sense of scale and the story behind the commission are enough to begin." },
    { "type": "textarea", "id": "promises", "label": "t:sections.enquiry.settings.promises.label", "default": "No-obligation initial discussion\nClear scope before any site work\nYour information kept private\nA considered reply within two working days" },
    { "type": "text", "id": "button_label", "label": "t:sections.enquiry.settings.button_label.label", "default": "Send Enquiry" },
    { "type": "textarea", "id": "success_message", "label": "t:sections.enquiry.settings.success_message.label", "default": "Thank you. Your enquiry has been sent. We will reply within two working days." },
    { "type": "text", "id": "name_placeholder", "label": "t:sections.enquiry.settings.name_placeholder.label", "default": "Full name" },
    { "type": "text", "id": "email_placeholder", "label": "t:sections.enquiry.settings.email_placeholder.label", "default": "you@example.com" },
    { "type": "text", "id": "location_placeholder", "label": "t:sections.enquiry.settings.location_placeholder.label", "default": "Town, county, or postcode" },
    { "type": "text", "id": "vision_placeholder", "label": "t:sections.enquiry.settings.vision_placeholder.label", "default": "What draws you to the idea? Who would you build it with?" },
    { "type": "text", "id": "garden_option", "label": "t:sections.enquiry.settings.garden_option.label", "default": "Garden (£5,000)" },
    { "type": "text", "id": "estate_option", "label": "t:sections.enquiry.settings.estate_option.label", "default": "Estate (£7,500)" },
    { "type": "text", "id": "landmark_option", "label": "t:sections.enquiry.settings.landmark_option.label", "default": "Landmark (£10,000)" }
  ],
  "presets": [
    { "name": "t:sections.enquiry.presets.name" }
  ]
}
{% endschema %}
