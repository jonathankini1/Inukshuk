<section class="password-screen">
  <img class="password-screen__media" src="{{ 'hillside-landmark.jpg' | asset_url }}" alt="" width="2000" height="1125">
  <div class="password-card">
    <a class="logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <div class="form-banner form-banner--error" role="alert">
          <p>{{ 'password.error' | t }}</p>
        </div>
      {% endif %}
      <label class="field-label" for="StorePassword">{{ 'password.label' | t }}</label>
      <input id="StorePassword" type="password" name="password" autocomplete="current-password">
      <button class="submit-btn" type="submit">{{ 'password.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.password.name",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "A private preview" },
    { "type": "textarea", "id": "text", "label": "t:labels.text", "default": "Enter the store password to look around. The public site stays on its current address until this theme is published." }
  ]
}
{% endschema %}
